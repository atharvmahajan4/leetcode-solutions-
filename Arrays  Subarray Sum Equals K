import java.util.HashMap;
import java.util.Map;

class Solution {
    public int subarraySum(int[] nums, int k) {
        Map<Integer, Integer> prefixCount = new HashMap<>();
        
        
        prefixCount.put(0, 1);

        int currSum = 0;
        int result = 0;

        for (int num : nums) {
            currSum += num;

          
            result += prefixCount.getOrDefault(currSum - k, 0);

            
            prefixCount.put(currSum,
                    prefixCount.getOrDefault(currSum, 0) + 1);
        }

        return result;
    }
}
